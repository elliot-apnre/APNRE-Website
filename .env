# GA4 measurement ID and Meta Pixel ID are not secrets — they're visible
# in every visitor's page source regardless — so it's simplest to just
# commit the real values here rather than set them as Cloudflare Pages
# dashboard env vars. (If you'd rather keep them out of source for any
# reason, blank these and set VITE_GA4_ID / VITE_META_PIXEL_ID in the
# Cloudflare Pages project's Environment variables instead — that
# overrides this file at build time. See src/partials/head-shared.html for why the key must
# exist here even when blank.)
VITE_GA4_ID=G-WDLJLYGJCY
VITE_META_PIXEL_ID=

# Google Tag Manager container ID — same non-secret reasoning as above.
VITE_GTM_ID=GTM-P5H7NTCF
